# -----------------------------------------------------------------------------
# Chabad at Lehigh — environment variables
# Copy this file to .env.local for local development.
# In Vercel: Project → Settings → Environment Variables (add the same names).
# -----------------------------------------------------------------------------

# REQUIRED — Supabase project URL.
# Supabase dashboard → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# REQUIRED — Supabase publishable key (starts with sb_publishable_...).
# Supabase dashboard → Project Settings → API Keys → Publishable key.
# This key is designed to be public; row level security protects the data.
# (A legacy "anon" key also works here.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# REQUIRED in production — the public address of the site, no trailing slash.
# Used for sign-in links and calendar files. Example: https://chabadlehigh.org
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OPTIONAL — Cloudflare Turnstile site key to show a bot check on the sign-in
# form. Only set this after enabling Turnstile in Supabase (Auth → Attack
# Protection) with the matching secret key. Leave empty to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# NOTE: This app never needs the Supabase service-role / secret key.
# Do NOT add it to Vercel or to any NEXT_PUBLIC_ variable.
